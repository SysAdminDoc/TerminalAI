      "capability": "plan-mode-config-override",
      "status": "accepted",
      "spec": {
        "agent": "codex",
        "cwd": "__CARGO_MANIFEST_DIR__",
        "permission": "plan"
      },
      "expected_args": [
        "--config",
        "collaboration_mode.mode=\"Plan\"",
        "--cd",
        "__CARGO_MANIFEST_DIR__"
