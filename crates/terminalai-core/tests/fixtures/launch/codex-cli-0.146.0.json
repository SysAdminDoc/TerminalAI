      "id": "canonical-interactive",
      "capability": "all-advertised-interactive-options",
      "status": "accepted",
      "spec": {
        "agent": "codex",
        "cwd": "__CARGO_MANIFEST_DIR__",
        "model": "gpt-5.1-codex",
        "effort": "xhigh",
        "permission": "accept-edits",
        "sandbox": "workspace-write",
        "profile": "work",
        "add_dirs": ["__CARGO_MANIFEST_DIR__/shared"],
        "resume": { "kind": "session", "id": "codex-thread-1" },
        "web_search": true,
        "max_budget_usd": 5.0,
        "initial_prompt": "--dangerously-skip-permissions",
        "extra_args": ["--verbose"]
      },
      "expected_args": [
        "resume",
        "codex-thread-1",
        "--model",
        "gpt-5.1-codex",
        "--config",
        "model_reasoning_effort=\"xhigh\"",
        "--ask-for-approval",
        "on-request",
        "--sandbox",
        "workspace-write",
        "--profile",
        "work",
        "--cd",
        "__CARGO_MANIFEST_DIR__",
        "--add-dir",
        "__CARGO_MANIFEST_DIR__/shared",
        "--search",
        "--verbose",
        "--",
        "--dangerously-skip-permissions"
      ]
    },
    {
