{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "wdio",
  "description": "WebdriverIO-only capability for isolated UI tests",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "wdio:allow-execute",
    "allow-app-version",
    "allow-fleet-snapshot",
    "allow-review-snapshot",
    "allow-external-sessions",
    "allow-mark-reviewed",
    "allow-admission-config",
    "allow-set-admission",
    "allow-land-session",
    "allow-preview-launch",
    "allow-resolve-agent",
    "allow-agent-capabilities",
    "allow-launch-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-kill-session",
    "allow-focus-session",
    "allow-mark-read",
    "allow-toggle-pin",
    "allow-grid-snapshot",
    "allow-subscribe-output",
    "allow-stream-scrollback",
    "allow-stream-scrollback-history",
    "allow-broadcast-prompt",
    "allow-queued-prompts",
    "allow-enqueue-prompt",
    "allow-edit-queued-prompt",
    "allow-remove-queued-prompt",
    "allow-reorder-queued-prompt",
    "allow-pause-queue",
    "allow-resume-queue",
    "allow-attach-session-output",
    "allow-revive-session",
    "allow-archive-session",
    "allow-list-presets",
    "allow-list-templates",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-restore-builtin-presets",
    "allow-list-projects",
    "allow-scan-projects",
    "allow-list-stored-prompts",
    "allow-save-stored-prompt",
    "allow-delete-stored-prompt",
    "allow-work-run",
    "allow-start-work-run",
    "allow-approve-flagged-project",
    "allow-skip-work-project",
    "allow-set-work-run-paused",
    "allow-clear-work-run",
    "allow-list-project-roots",
    "allow-add-project-root",
    "allow-remove-project-root",
    "allow-pick-folder",
    "allow-pick-extra-dirs",
    "allow-preflight-report",
    "allow-preflight-fix",
    "allow-open-external-url"
  ]
}
