{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The TerminalAI desktop surface. Local origin only; no remote windows.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "allow-app-version",
    "allow-fleet-snapshot",
    "allow-review-snapshot",
    "allow-external-sessions",
    "allow-mark-reviewed",
    "allow-land-session",
    "allow-preview-launch",
    "allow-resolve-agent",
    "allow-launch-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-kill-session",
    "allow-focus-session",
    "allow-mark-read",
    "allow-toggle-pin",
    "allow-subscribe-output",
    "allow-stream-scrollback",
    "allow-attach-session-output",
    "allow-revive-session",
    "allow-archive-session",
    "allow-list-presets",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-pick-folder",
    "allow-pick-extra-dirs",
    "allow-preflight-report",
    "allow-preflight-fix",
    "allow-open-external-url"
  ],
  "local": true,
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ]
}
